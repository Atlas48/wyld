doctype xml
- var background='#'
case type
	//story
	when 0 
		- background+='00BF00'
	//boon
	when 1
		- background+='0000BF'
	//waylay
	when 2 
		- background+='BF0000'
svg(width=200 height=280 xmlns="http://www.w3.org/2000/svg")
	defs
		clipPath(id="imgclip")
			rect(x=16 y=40 width=168 height=120 rx=4)
	rect(width=200 height=280 fill=background rx=8)

	rect(x=4 y=4 width=192 height=272 fill="none" stroke="#D4AF37" stroke-width=4 rx=6)

	image(href=img||`../img/${basename}.png` x=16 y=40 width=168 height=120 clip-path="url(#image-clip)")

	rect(x=12 y=170 width=176 height=36 fill=background stroke="#d4af37" stroke-width=2)
	text(x=100 y=194 font-family="serif" font-size=18 fill="#FFF" text-anchor="middle" font-weight="bold")=title

	foreignObject(x=16 y=210 width=168 height=60)
		div(xmlns="http://www.w3.org/1999/xhtml" style="font-family: sans-serif; font-size: 12px; color: #CCC; text-align: center; line-height: 1.2;")!=content

	if xp
		circle(cx=30 cy=30 r=20 fill="#4A5899" stroke="#7792d4" stroke-width=4)
		text(x=30 y=38 font-family="serif" font-size=24 fill="#FFF" text-anchor="middle" font-weight="bold")=xp
