doctype xml
- var background
- var border=background='#'
- const divcss="font-size:12px;color:#313131;text-align:center;vertical-align:middle;margin:0;padding:0 12px;box-sizing:border-box"
case type
	//story
	when 0 
		- background+='00BF00'
	//boon
	when 1
		- background+='0000BF'
	//waylay
	when 2 
		- background+='BF0000'
if special
	- border+='D4AF37'
else
	- border='D4D4D4'
svg(width=200 height=280 xmlns="http://www.w3.org/2000/svg")
	defs
		clipPath(id="imgclip")
			rect(x=16 y=40 width=168 height=120 rx=4)
	rect(width=200 height=280 fill=background.replace(/00/g,"7F") rx=8)

	rect(x=4 y=4 width=192 height=272 fill="none" stroke=border stroke-width=4 rx=6)

	image(href=imguri x=16 y=40 width=168 height=120 clip-path="url(#imgclip)")

	rect(x=12 y=170 width=176 height=36 fill=background stroke=border stroke-width=2)
	text(x=100 y=194 font-family="serif" font-size=18 fill="#FFF" text-anchor="middle" font-weight="bold")=title

	foreignObject(x=0 y=200 width=200 height=100)
		div(xmlns="http://www.w3.org/1999/xhtml" style=divcss)!=content

	if typeof xp !== "undefined" && xp !== null && xp!=0
		circle(cx=30 cy=30 r=20 fill="#4A5899" stroke="#7792D4" stroke-width=4)
		text(x=30 y=38 font-family="serif" font-size=24 fill="#AAA" text-anchor="middle" font-weight="bold")=xp
